# ─── Frontend (React / Vite) ────────────────────────────────────────────────
# Base URL of the FastAPI service. Leave empty to run the UI in DEMO MODE with
# the local reference risk engine. Never put database or Supabase keys here —
# anything prefixed VITE_ is shipped to the browser.
VITE_API_BASE_URL=http://localhost:8000

# ─── Backend (FastAPI) ──────────────────────────────────────────────────────
# Supabase-hosted PostgreSQL/PostGIS connection string (server side only).
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Comma-separated list of allowed browser origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Optional: pin the sentence-transformer used for the text signal.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional server-side LLM explanation layer. Never expose this key as VITE_*
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
